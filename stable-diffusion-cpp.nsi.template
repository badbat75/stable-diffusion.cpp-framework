; stable-diffusion.cpp NSIS Installer Template
; Placeholders replaced by 04-package.ps1:
;   @VERSION@, @STAGING_DIR@, @OUTPUT_FILE@

!include "MUI2.nsh"
!include "WinMessages.nsh"
!include "LogicLib.nsh"
!include "nsDialogs.nsh"

; ── Installer metadata ──────────────────────────────────────────────
Name "stable-diffusion.cpp @VERSION@"
OutFile "@OUTPUT_FILE@"
InstallDir "$PROGRAMFILES64\stable-diffusion.cpp"
InstallDirRegKey HKLM "Software\stable-diffusion.cpp" "InstallDir"
RequestExecutionLevel admin
SetCompressor zlib

; Write to the native 64-bit registry view, not Wow6432Node — otherwise
; PowerShell reading HKLM:\Software\stable-diffusion.cpp can't find our keys.
; Must be called from within a Function (not at top-level), so apply it in onInit.
Function .onInit
    SetRegView 64
FunctionEnd
Function un.onInit
    SetRegView 64
FunctionEnd

; ── MUI pages ───────────────────────────────────────────────────────
!define MUI_ICON "@STAGING_DIR@\stable-diffusion.ico"
!define MUI_UNICON "@STAGING_DIR@\stable-diffusion.ico"

; All configuration (Port / Hostname / Threads / ModelsDir / per-model
; presets / MCP client registration) is handled post-install by the
; sd-config GUI, launchable from the Finish page below or any time later
; from the "Configure (GUI)" Start Menu shortcut. Keeping the installer
; lean avoids duplicating the wizard's logic in two places.
!define MUI_FINISHPAGE_RUN ""
!define MUI_FINISHPAGE_RUN_FUNCTION LaunchConfigurator
!define MUI_FINISHPAGE_RUN_TEXT "Launch the configuration tool now"
; Default unchecked so silent / scripted installs don't pop a GUI.
!define MUI_FINISHPAGE_RUN_NOTCHECKED

!insertmacro MUI_PAGE_WELCOME
Page custom CheckPreviousInstall
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; ── Upgrade: remove previous installation silently ──────────────────
Function CheckPreviousInstall
    ReadRegStr $0 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" "UninstallString"
    StrCmp $0 "" done

    ReadRegStr $1 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" "DisplayVersion"
    MessageBox MB_YESNO|MB_ICONQUESTION \
        "stable-diffusion.cpp $1 is already installed.$\n$\nUninstall the previous version before continuing?" \
        IDYES uninstall

    ; User chose No — abort
    Abort

    uninstall:
        ; Strip quotes from UninstallString
        StrCpy $2 $0 "" 1   ; remove first char (quote)
        StrLen $3 $2
        IntOp $3 $3 - 1
        StrCpy $2 $2 $3     ; remove last char (quote)
        ExecWait '"$2" /S _?=$INSTDIR'
        Delete "$INSTDIR\uninstall.exe"
        RMDir "$INSTDIR"
    done:
FunctionEnd

; ── Launch sd-config from the Finish page as the calling user ───────
; The installer runs elevated (RequestExecutionLevel admin) but sd-config
; writes per-user files under %LOCALAPPDATA%; launching it directly with
; Exec would invoke it as the elevating admin, producing files in the
; wrong profile. Spawning it via explorer.exe drops the elevation token
; because explorer is already running under the user's session — a
; well-known NSIS workaround that avoids pulling in UAC.dll / similar
; plugins.
Function LaunchConfigurator
    Exec '"$WINDIR\explorer.exe" "$INSTDIR\bin\sd-config.exe"'
FunctionEnd

; ── Main section: binaries ──────────────────────────────────────────
Section "stable-diffusion.cpp binaries (required)" SecMain
    SectionIn RO

    SetOutPath "$INSTDIR\bin"
    File /r "@STAGING_DIR@\bin\*.*"

    ; Runtime + init scripts. server.ini / presets.ini / MCP-client configs
    ; are written on demand by sd-config.exe (post-install GUI) or by the
    ; CLI flavour of the same binary. The lazy fallback in run-server.ps1
    ; still invokes the PowerShell wizards if the user never opens the GUI.
    SetOutPath "$INSTDIR"
    File "@STAGING_DIR@\run-server.ps1"
    File "@STAGING_DIR@\common-functions.ps1"
    File "@STAGING_DIR@\mcp-server.ps1"
    File "@STAGING_DIR@\stable-diffusion.ico"

    ; Uninstaller
    WriteUninstaller "$INSTDIR\uninstall.exe"

    ; Registry — Add/Remove Programs
    WriteRegStr HKLM "Software\stable-diffusion.cpp" "InstallDir" "$INSTDIR"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "DisplayName" "stable-diffusion.cpp @VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "DisplayVersion" "@VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "Publisher" "stable-diffusion.cpp"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp" \
        "NoRepair" 1
SectionEnd

; ── Optional: Add to PATH ──────────────────────────────────────────
Section "Add to system PATH" SecPath
    ; Use PowerShell to safely append to PATH (idempotent)
    nsExec::ExecToLog 'powershell -NoProfile -Command "\
        $$regKey = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey(\
            \"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\", $$true);\
        $$path = $$regKey.GetValue(\"Path\", \"\", \"DoNotExpandEnvironmentNames\");\
        $$dir = \"$INSTDIR\\bin\";\
        if ($$path -notlike \"*$$dir*\") {\
            $$regKey.SetValue(\"Path\", \"$$path;$$dir\", \"ExpandString\");\
        };\
        $$regKey.Close()"'
    ; Broadcast WM_SETTINGCHANGE so new shells pick up the change
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
SectionEnd

; ── Optional: Start Menu shortcuts ─────────────────────────────────
Section "Start Menu shortcuts" SecShortcuts
    CreateDirectory "$SMPROGRAMS\stable-diffusion.cpp"
    ; Shortcuts target pwsh.exe (PowerShell 7+) — Windows PowerShell 5.1 is not
    ; supported by these scripts. pwsh.exe is resolved via PATH at click time.
    ; SetOutPath also becomes the shortcut's WorkingDirectory — point it at a
    ; writable per-user data dir so first-run files don't land in Program Files.
    SetOutPath "$LOCALAPPDATA\stable-diffusion.cpp"
    CreateShortCut "$SMPROGRAMS\stable-diffusion.cpp\stable-diffusion.cpp.lnk" "pwsh.exe" "-NoProfile -ExecutionPolicy Bypass -File $\"$INSTDIR\run-server.ps1$\"" "$INSTDIR\stable-diffusion.ico"
    ; sd-config.exe: GUI configurator (no args) backing server.ini, presets.ini,
    ; and the MCP-client configs (Claude Code / Desktop / OpenCode). The same
    ; binary also exposes a `server`, `preset`, `mcp` CLI for scripted use.
    CreateShortCut "$SMPROGRAMS\stable-diffusion.cpp\Configure.lnk" "$INSTDIR\bin\sd-config.exe" "" "$INSTDIR\bin\sd-config.exe"
    SetOutPath "$INSTDIR"
    CreateShortCut "$SMPROGRAMS\stable-diffusion.cpp\Uninstall.lnk" "$INSTDIR\uninstall.exe"
    ; Notify shell that Start Menu changed
    System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0x1000, p 0, p 0)'
SectionEnd

; ── Section descriptions ────────────────────────────────────────────
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SecMain} "Core stable-diffusion.cpp executables (sd-server, sd-config) and runtime scripts."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecPath} "Add stable-diffusion.cpp bin directory to system PATH."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecShortcuts} "Start Menu shortcuts: launcher and GUI configurator."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; ── Uninstaller ─────────────────────────────────────────────────────
Section "Uninstall"
    ; Remove from PATH
    nsExec::ExecToLog 'powershell -NoProfile -Command "\
        $$regKey = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey(\
            \"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\", $$true);\
        $$path = $$regKey.GetValue(\"Path\", \"\", \"DoNotExpandEnvironmentNames\");\
        $$dir = \"$INSTDIR\\bin\";\
        $$newPath = ($$path -split \";\" | Where-Object { $$_ -ne $$dir }) -join \";\";\
        $$regKey.SetValue(\"Path\", $$newPath, \"ExpandString\");\
        $$regKey.Close()"'
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000

    ; Files
    RMDir /r "$INSTDIR\bin"
    Delete "$INSTDIR\run-server.ps1"
    Delete "$INSTDIR\common-functions.ps1"
    Delete "$INSTDIR\mcp-server.ps1"
    Delete "$INSTDIR\stable-diffusion.ico"
    Delete "$INSTDIR\uninstall.exe"
    RMDir "$INSTDIR"

    ; Start Menu
    Delete "$SMPROGRAMS\stable-diffusion.cpp\*.lnk"
    RMDir "$SMPROGRAMS\stable-diffusion.cpp"

    ; Registry
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\stable-diffusion.cpp"
    DeleteRegKey HKLM "Software\stable-diffusion.cpp"

    ; User runtime config + per-model presets + logs.
    ; Defaults to keeping them (survives upgrade/reinstall), but ask explicitly
    ; so the user can do a clean uninstall when they want.
    ; Note: uninstaller runs elevated, so $LOCALAPPDATA resolves to the
    ; elevating admin's LOCALAPPDATA — works for single-user boxes where
    ; installer and runtime user are the same account.
    StrCpy $0 "$LOCALAPPDATA\stable-diffusion.cpp"
    IfFileExists "$0\config\server.ini" 0 skip_user_data
    ; /SD IDNO: during silent uninstall (upgrade flow runs the previous
    ; uninstaller with /S) auto-default to "No" so user data is preserved
    ; without prompting. Interactive uninstalls still see the dialog.
    MessageBox MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2 \
        "Delete user configuration, per-model presets, and logs at $0?$\n$\nThis includes runtime settings and sd-server logs. Choose No to keep them for a future reinstall." \
        /SD IDNO IDNO skip_user_data
    RMDir /r "$0"
    skip_user_data:
SectionEnd
