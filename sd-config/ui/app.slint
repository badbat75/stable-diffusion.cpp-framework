// stable-diffusion.cpp configurator — Slint UI.
//
// Windows-11-Settings-style chrome: a left navigation rail (Server / Models /
// MCP) and a content area that swaps pages via `current_tab`. There is no top
// header — the live sd-server status pill sits in the always-on footer status
// bar (bottom-right, beside the action-result toast), and the app icon in the
// top-right corner opens a small overflow menu whose "About" item shows
// project info + the sd-server engine version. Sections inside each page are
// rounded "cards" rather than stock GroupBoxes so the result reads like a
// modern WinUI app rather than a bare widget dump.
//
// All persistence still flows through the same Rust modules the CLI uses
// (server_cfg / presets / mcp). Property names and callback signatures are
// unchanged so gui.rs needs no rewiring (the About menu / dialog are driven by
// the self-contained `show_app_menu` / `show_about_dialog` UI flags).
//
// Slint can't bind a `let` in a callback body, so file-picker callbacks take
// the current value and return the new value (= the dialog result, or the
// passed-in current value if the user cancelled). Optional numeric fields are
// typed as `string` to allow blank/unset.

import {
    LineEdit, ComboBox, CheckBox, Button, ListView, ScrollView, Palette
} from "std-widgets.slint";

export struct McpClient {
    id: string,
    label: string,
    config_path: string,
    installed: bool,
    note: string,
}

export struct PresetSummary {
    id: string,
    model: string,
    model_type: string,
}

// One LoRA row in the Models-tab editor: a path RELATIVE to the loras root
// (display label) and its per-LoRA weight ("" = 1.0). The list is the
// `lora_entries` property; gui.rs splits it out of / recombines it into the
// stored `path:mult` form (model_scan::lora_split_display / lora_combine_full).
export struct LoraEntry {
    path: string,
    weight: string,
}

// Form-state of the currently edited preset. Mirrors the keys
// the renderer in presets.rs writes into presets.ini.
export struct PresetForm {
    id: string,
    model: string,
    model_type: string,
    uncond_diffusion_model: string,
    vae: string,
    llm: string,
    t5xxl: string,
    clip_l: string,
    clip_g: string,
    // LoRAs are edited separately (the `lora_entries` row-model), NOT here.
    // Pre-rename lora-model-dir passthrough — round-tripped only, NO widget;
    // see Preset::legacy_lora_dir in presets.rs.
    legacy_lora_dir: string,
    lora_apply_mode: string,
    embd_dir: string,
    weight_type: string,
    offload_to_cpu: bool,
    mmap: bool,
    fa: bool,
    diffusion_fa: bool,
    clip_on_cpu: bool,
    vae_on_cpu: bool,
    vae_tiling: bool,
    max_vram: string,
    sampler: string,
    flow_shift: string,
    steps: int,
    cfg_scale: string,
    guidance: string,
    width: int,
    height: int,
}

// ── Reusable visual pieces ───────────────────────────────────────────────

// A row in the left nav rail. WinUI 3 signature: subtle accent fill +
// vertical accent bar on the leading edge when selected; faint hover
// elsewhere. Glyphs use Segoe Fluent Icons (PUA codepoints) which is the
// Windows 11 system icon font — falls back to MDL2 Assets glyphs at the
// same codepoints on older Windows.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    background: selected
        ? Palette.accent-background.transparentize(0.82)
        : (touch.has-hover ? Palette.alternate-background : transparent);

    // Vertical accent bar on the leading edge — the bit your eye locks onto.
    if selected : Rectangle {
        x: 0; y: 8px; width: 3px; height: parent.height - 16px;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;

        Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 16px;
            color: root.selected ? Palette.accent-background : Palette.foreground;
            vertical-alignment: center;
            width: 22px;
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The live sd-server status pill (lives in the footer status bar). Green when
// sd-server is alive, neutral otherwise. Click to force-refresh the underlying
// state-file probe.
component StatusPill inherits Rectangle {
    in property <bool> running;
    in property <string> text;
    callback clicked;

    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.running ? #2e7d32 : Palette.border;
    background: root.running
        ? #2e7d32.transparentize(0.88)
        : Palette.alternate-background;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.text;
            color: Palette.foreground;
            vertical-alignment: center;
            font-size: 12px;
        }
        // Status dot on the trailing edge. Wrap in a column for true vertical
        // centering regardless of text baseline.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.running ? #2e7d32 : #888888;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A rounded card with an optional heading above. Acts as a drop-in
// replacement for std-widgets' GroupBox but with the modern flat look.
component SectionCard {
    in property <string> heading;
    in property <length> content_spacing: 10px;
    in property <length> content_padding: 16px;

    VerticalLayout {
        spacing: 8px;

        if root.heading != "" : Text {
            text: root.heading;
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
        }

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: root.content_padding;
                spacing: root.content_spacing;
                @children
            }
        }
    }
}

component LabeledField inherits HorizontalLayout {
    in property <string> label;
    in property <length> label_width: 110px;
    spacing: 8px;
    alignment: stretch;
    Text {
        text: root.label;
        vertical-alignment: center;
        width: root.label_width;
        font-size: 13px;
    }
    @children
}

export component AppWindow inherits Window {
    title: "stable-diffusion.cpp configurator";
    icon: window_icon;
    // Sized for the Models tab, which is the densest page: 200px nav rail +
    // 240px preset list + LabeledField rows that pack a 110px label, an
    // elastic LineEdit, and a "…" browse button. Below ~1000px the browse
    // buttons get pushed off the right edge.
    min-width: 1000px;
    min-height: 660px;
    preferred-width: 1180px;
    preferred-height: 760px;
    background: Palette.background;

    // Set from Rust at startup (gui::set_window_icon) — decoded out of the
    // .ico embedded by build.rs. Slint's compile-time @image-url doesn't
    // handle .ico, so we go through the runtime image crate instead.
    in property <image> window_icon;

    // ── Navigation ───────────────────────────────────────────────────
    // 0 = Server, 1 = Models, 2 = MCP.
    in-out property <int> current_tab: 0;

    // ── Header / live status ─────────────────────────────────────────
    // Driven by gui.rs reading run\sd-server.state on a 2s Timer.
    in property <bool> server_running: false;
    in property <string> server_status_text: "stopped";
    // Output of `sd-server.exe --version`, parsed down to just the version
    // tag (e.g. "master-596-90e87bc"). Empty until gui::spawn_version_probe
    // finishes — the header hides the chip until then.
    in property <string> server_version: "";
    // sd-config's own version, from CARGO_PKG_VERSION (set by gui::run).
    // Surfaced in the About dialog so users can report which configurator
    // build they're on independently of the sd-server engine version.
    in property <string> app_version: "";

    // ── Server tab state ─────────────────────────────────────────────
    in-out property <string> server_port: "1234";
    // "localhost" | "0.0.0.0" | a specific interface IP (e.g. "192.168.1.10").
    // The picker exposes localhost, 0.0.0.0, and one row per detected IPv4
    // interface; `bind_labels` is the human-readable list (with iface name +
    // CIDR), `bind_values` is the corresponding hostname strings, and
    // `bind_index` is what the ComboBox uses to track the current selection.
    in-out property <string> server_hostname: "localhost";
    in-out property <[string]> bind_labels;
    in-out property <[string]> bind_values;
    in-out property <int> bind_index: 0;
    in-out property <string> server_threads: "";
    in-out property <string> server_models_dir: "";

    // ── Models tab state ─────────────────────────────────────────────
    in-out property <[PresetSummary]> presets;
    in-out property <int> selected_preset_index: -1;
    in-out property <PresetForm> form;
    in-out property <string> presets_path: "";

    // File-field dropdowns. For each of the six file fields (main model +
    // five sub-models) `<field>_labels` is what the ComboBox shows (basename
    // for scanned files, `(none)` / `(custom) <basename>` for the synthetic
    // rows), `<field>_values` is the parallel array of absolute paths that
    // get written into the preset, and `<field>_index` tracks the selected
    // row. All three are rebuilt by gui::refresh_file_options() any time
    // ModelsDir changes or a different preset is loaded.
    in-out property <[string]> model_labels;
    in-out property <[string]> model_values;
    in-out property <int> model_index: -1;
    in-out property <[string]> uncond_dm_labels;
    in-out property <[string]> uncond_dm_values;
    in-out property <int> uncond_dm_index: -1;
    in-out property <[string]> vae_labels;
    in-out property <[string]> vae_values;
    in-out property <int> vae_index: -1;
    in-out property <[string]> llm_labels;
    in-out property <[string]> llm_values;
    in-out property <int> llm_index: -1;
    in-out property <[string]> t5xxl_labels;
    in-out property <[string]> t5xxl_values;
    in-out property <int> t5xxl_index: -1;
    in-out property <[string]> clip_l_labels;
    in-out property <[string]> clip_l_values;
    in-out property <int> clip_l_index: -1;
    in-out property <[string]> clip_g_labels;
    in-out property <[string]> clip_g_values;
    in-out property <int> clip_g_index: -1;
    // LoRA "Add" dropdown — labels only (relative paths under the loras root,
    // incl. sub-folders, with a sentinel row at index 0). It's an action
    // picker that appends a row to `lora_entries`, so unlike the model combos
    // it tracks no current selection and needs no parallel `values` / `index`.
    in-out property <[string]> lora_labels;
    // The editable LoRA rows of the current preset (path + weight each). Driven
    // by a Rust-side VecModel so per-row weight edits mutate in place.
    in-out property <[LoraEntry]> lora_entries;

    // ── MCP tab state ────────────────────────────────────────────────
    in-out property <[McpClient]> mcp_clients;

    // ── New-preset dialog state ─────────────────────────────────────
    // Flipped on by gui.rs when "New…" is clicked. The embedded modal
    // shows a scanned list of model files (under ModelsDir, same
    // category as the editor's Model dropdown) so the user picks from
    // a list instead of an OS file browser. `new_dialog_source_id` is
    // non-empty when a preset is selected in the list, in which case
    // the Clone button is shown alongside Empty.
    in-out property <bool> show_new_kind_picker: false;
    in-out property <string> new_dialog_source_id: "";
    in-out property <[string]> dialog_model_labels;
    in-out property <[string]> dialog_model_values;
    in-out property <int> dialog_model_index: -1;

    // ── Rename-preset dialog state ──────────────────────────────────
    // Flipped on by clicking "Rename…". `rename_old_id` is the section
    // header about to be rewritten (read-only display); `rename_new_id`
    // is the live editable buffer, pre-seeded with the current id.
    in-out property <bool> show_rename_dialog: false;
    in-out property <string> rename_old_id: "";
    in-out property <string> rename_new_id: "";

    // ── App menu / About dialog ─────────────────────────────────────
    // The top-right app-icon button opens a small overflow menu
    // (`show_app_menu`); its "About" item opens the About modal
    // (`show_about_dialog`), which surfaces project info + the sd-server
    // engine version (`server_version`). Both are self-contained UI flags —
    // no Rust wiring beyond the version probe that already feeds the header.
    in-out property <bool> show_app_menu: false;
    in-out property <bool> show_about_dialog: false;

    // ── Status / toast ───────────────────────────────────────────────
    in-out property <string> status_text: "";
    in-out property <bool> status_is_error: false;

    // ── Callbacks (Rust side) ───────────────────────────────────────
    callback save_server();
    callback revert_server();
    callback browse_models_dir(string) -> string;

    callback select_preset(int);
    callback save_preset();
    callback revert_preset();
    callback delete_preset(string);
    callback new_preset();
    callback pick_new_empty();
    callback pick_new_clone();
    callback rename_preset(string, string);
    callback browse_dir(string, string) -> string;
    // Append a scanned (relative) LoRA as a new row in `lora_entries` (weight
    // defaults to blank = 1.0), warning first when it lives in a different
    // sub-folder than the existing rows. No-op if the warning is cancelled.
    callback add_lora(string);
    // Drop the LoRA row at the given index from `lora_entries`.
    callback remove_lora(int);

    callback mcp_install(string);
    callback mcp_uninstall(string);
    callback mcp_refresh();

    callback refresh_status();
    callback stop_server();

    VerticalLayout {
        spacing: 0px;

        // ─── Body: nav rail | content ─────────────────────────────
        // (No top header — the app icon / About menu floats top-right and the
        // sd-server status pill moved into the footer status bar below.)
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Nav rail
            Rectangle {
                width: 200px;
                background: Palette.background;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Palette.border;
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;

                    NavItem {
                        // Segoe Fluent Icons: Settings (gear)
                        glyph: "\u{E713}";
                        label: "Server";
                        selected: root.current_tab == 0;
                        clicked => { root.current_tab = 0; }
                    }
                    NavItem {
                        // Segoe Fluent Icons: Pictures
                        glyph: "\u{EB9F}";
                        label: "Models";
                        selected: root.current_tab == 1;
                        clicked => { root.current_tab = 1; }
                    }
                    NavItem {
                        // Segoe Fluent Icons: PlugConnected
                        glyph: "\u{F003}";
                        label: "MCP clients";
                        selected: root.current_tab == 2;
                        clicked => { root.current_tab = 2; }
                    }
                }
            }

            // Content area — page is selected by `current_tab`. The inner
            // VerticalLayout ensures whichever conditional page is active
            // stretches to fill the available room (a bare Rectangle gives
            // its children their preferred size only).
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;

                VerticalLayout {

                // ─────────────── Page 0: Server ───────────────
                if root.current_tab == 0 : ScrollView {
                    // Pin the content width to the visible area so cards/fields
                    // never extend under (or past) the vertical scrollbar; the
                    // 24px padding then becomes the scrollbar gutter.
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        alignment: start;

                        Text {
                            text: "Server";
                            font-size: 22px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        Text {
                            text: "Machine-wide sd-server settings (server.ini). Per-model knobs live under Models.";
                            color: Palette.foreground.transparentize(0.4);
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        SectionCard {
                            heading: "Network";
                            LabeledField {
                                label: "Port";
                                LineEdit {
                                    text: root.server_port;
                                    input-type: number;
                                    placeholder-text: "1234";
                                    edited(t) => { root.server_port = t; }
                                }
                            }
                            LabeledField {
                                label: "Bind to";
                                ComboBox {
                                    model: root.bind_labels;
                                    current-index: root.bind_index;
                                    selected(value) => {
                                        root.bind_index = self.current-index;
                                        if (self.current-index >= 0 && self.current-index < root.bind_values.length) {
                                            root.server_hostname = root.bind_values[self.current-index];
                                        }
                                    }
                                }
                            }
                        }

                        SectionCard {
                            heading: "Resources";
                            LabeledField {
                                label: "CPU threads";
                                LineEdit {
                                    text: root.server_threads;
                                    input-type: number;
                                    placeholder-text: "blank = half the logical-core count";
                                    edited(t) => { root.server_threads = t; }
                                }
                            }
                            LabeledField {
                                label: "Models folder";
                                LineEdit {
                                    text: root.server_models_dir;
                                    placeholder-text: "where your .gguf / .safetensors files live";
                                    edited(t) => { root.server_models_dir = t; }
                                }
                                Button {
                                    text: "Browse…";
                                    clicked => {
                                        root.server_models_dir = root.browse_models_dir(root.server_models_dir);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                text: "Revert";
                                clicked => { root.revert_server(); }
                            }
                            Button {
                                text: "Save changes";
                                primary: true;
                                clicked => { root.save_server(); }
                            }
                        }
                    }
                }

                // ─────────────── Page 1: Models ───────────────
                if root.current_tab == 1 : HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // Left column: preset list
                    VerticalLayout {
                        width: 240px;
                        spacing: 10px;

                        Text {
                            text: "Presets";
                            font-size: 14px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Rectangle {
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: 8px;
                            background: Palette.alternate-background;
                            min-height: 280px;
                            vertical-stretch: 1;

                            ListView {
                                for p[i] in root.presets : Rectangle {
                                    height: 36px;
                                    background: i == root.selected_preset_index
                                        ? Palette.accent-background.transparentize(0.82)
                                        : (item-touch.has-hover ? Palette.background : transparent);

                                    if i == root.selected_preset_index : Rectangle {
                                        x: 0; y: 6px; width: 3px; height: parent.height - 12px;
                                        border-radius: 1.5px;
                                        background: Palette.accent-background;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: p.id;
                                            font-size: 12px;
                                            color: Palette.foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    item-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_preset(i); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "New…";
                                clicked => { root.new_preset(); }
                            }
                            Button {
                                text: "Rename…";
                                enabled: root.selected_preset_index >= 0;
                                clicked => {
                                    root.rename_old_id = root.form.id;
                                    root.rename_new_id = root.form.id;
                                    root.show_rename_dialog = true;
                                }
                            }
                            Button {
                                text: "Delete";
                                enabled: root.selected_preset_index >= 0;
                                clicked => { root.delete_preset(root.form.id); }
                            }
                        }

                        Text {
                            text: root.presets_path;
                            font-size: 10px;
                            color: Palette.foreground.transparentize(0.5);
                            wrap: word-wrap;
                        }
                    }

                    // Right column: editor.
                    ScrollView {
                        horizontal-stretch: 1;
                        // Keep the editor content within the visible width so it
                        // doesn't slide under the vertical scrollbar.
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 14px;

                            Text {
                                text: root.selected_preset_index >= 0
                                    ? "Preset id: " + root.form.id
                                    : "Select a preset on the left, or click New…";
                                font-size: 14px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            SectionCard {
                                heading: "Model";
                                LabeledField {
                                    label: "Type";
                                    ComboBox {
                                        model: ["standalone (Flux/SD3/Wan/Qwen…)", "allinone (SD1.x/SDXL bundle)"];
                                        current-index: root.form.model_type == "allinone" ? 1 : 0;
                                        selected(value) => {
                                            root.form.model_type = self.current-index == 1 ? "allinone" : "standalone";
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "File";
                                    ComboBox {
                                        model: root.model_labels;
                                        // `<=>` (not `:`) because std-widgets' ComboBoxBase has a
                                        // `changed model => reset-current()` hook that writes to its
                                        // own current-index on every model swap. With a one-way `:`
                                        // binding that internal write severs the link to
                                        // root.model_index — display freezes after the first preset
                                        // switch. Two-way keeps both sides in lockstep.
                                        current-index <=> root.model_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.model_values.length) {
                                                root.form.model = root.model_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                            }

                            SectionCard {
                                heading: "Sub-model paths (only what the architecture needs)";
                                LabeledField {
                                    label: "Uncond DM";
                                    ComboBox {
                                        model: root.uncond_dm_labels;
                                        // Ideogram4's standalone unconditional transformer
                                        // (--uncond-diffusion-model). See model_index above for `<=>`.
                                        current-index <=> root.uncond_dm_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.uncond_dm_values.length) {
                                                root.form.uncond_diffusion_model = root.uncond_dm_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "VAE";
                                    ComboBox {
                                        model: root.vae_labels;
                                        // See `current-index <=> root.model_index` above for why.
                                        current-index <=> root.vae_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.vae_values.length) {
                                                root.form.vae = root.vae_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "LLM";
                                    ComboBox {
                                        model: root.llm_labels;
                                        current-index <=> root.llm_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.llm_values.length) {
                                                root.form.llm = root.llm_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "T5-XXL";
                                    ComboBox {
                                        model: root.t5xxl_labels;
                                        current-index <=> root.t5xxl_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.t5xxl_values.length) {
                                                root.form.t5xxl = root.t5xxl_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "CLIP-L";
                                    ComboBox {
                                        model: root.clip_l_labels;
                                        current-index <=> root.clip_l_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.clip_l_values.length) {
                                                root.form.clip_l = root.clip_l_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "CLIP-G";
                                    ComboBox {
                                        model: root.clip_g_labels;
                                        current-index <=> root.clip_g_index;
                                        selected(value) => {
                                            if (self.current-index >= 0 && self.current-index < root.clip_g_values.length) {
                                                root.form.clip_g = root.clip_g_values[self.current-index];
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "LoRAs";
                                    // One row per LoRA: relative path, its weight to the RIGHT, and a
                                    // remove button. The "+ Add a LoRA…" picker sits BELOW the rows.
                                    VerticalLayout {
                                        spacing: 6px;
                                        if root.lora_entries.length > 0 : HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "file";
                                                horizontal-stretch: 1;
                                                font-size: 11px;
                                                color: Palette.foreground.transparentize(0.45);
                                            }
                                            Text {
                                                text: "weight";
                                                width: 90px;
                                                font-size: 11px;
                                                color: Palette.foreground.transparentize(0.45);
                                            }
                                            Rectangle { width: 28px; }
                                        }
                                        for entry[i] in root.lora_entries : HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: entry.path;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            LineEdit {
                                                width: 90px;
                                                text: entry.weight;
                                                placeholder-text: "1.0";
                                                // Mutates the row in the backing VecModel in place;
                                                // read back on save by combine_lora_entries.
                                                edited(t) => { root.lora_entries[i].weight = t; }
                                            }
                                            Button {
                                                width: 28px;
                                                // U+00D7 (×) — in the default UI font, unlike U+2715
                                                // (✕) which rendered as a tofu box.
                                                text: "×";
                                                clicked => { root.remove_lora(i); }
                                            }
                                        }
                                        ComboBox {
                                            model: root.lora_labels;
                                            // Row 0 is the "+ Add a LoRA…" sentinel; picking a real row
                                            // appends it as a new LoRA row and snaps back to the sentinel
                                            // so another (or the same) LoRA can be added next.
                                            selected(value) => {
                                                if (self.current-index >= 1) {
                                                    root.add_lora(value);
                                                    self.current-index = 0;
                                                }
                                            }
                                        }
                                    }
                                }
                                LabeledField {
                                    label: "LoRA apply (all)";
                                    ComboBox {
                                        // blank = sd-server default (auto). auto picks at_runtime on
                                        // quantized weights (~9x slower/step); immediately merges once.
                                        model: ["", "auto", "immediately", "at_runtime"];
                                        current-value: root.form.lora_apply_mode;
                                        selected(value) => { root.form.lora_apply_mode = value; }
                                    }
                                }
                                LabeledField {
                                    label: "Embed dir";
                                    LineEdit { text: root.form.embd_dir; edited(t) => { root.form.embd_dir = t; } }
                                    Button { text: "…"; clicked => { root.form.embd_dir = root.browse_dir("embd_dir", root.form.embd_dir); } }
                                }
                            }

                            SectionCard {
                                heading: "Memory / performance";
                                LabeledField {
                                    label: "Weight type";
                                    ComboBox {
                                        model: ["", "f32", "f16", "q8_0", "q5_1", "q5_0", "q4_1", "q4_0", "q2_K", "q3_K", "q4_K"];
                                        current-value: root.form.weight_type;
                                        selected(value) => { root.form.weight_type = value; }
                                    }
                                }
                                LabeledField {
                                    label: "Max VRAM (GiB)";
                                    LineEdit {
                                        text: root.form.max_vram;
                                        placeholder-text: "blank = unlimited";
                                        edited(t) => { root.form.max_vram = t; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    CheckBox { text: "offload-to-cpu"; checked: root.form.offload_to_cpu; toggled => { root.form.offload_to_cpu = self.checked; } }
                                    CheckBox { text: "mmap";           checked: root.form.mmap;           toggled => { root.form.mmap = self.checked; } }
                                    CheckBox { text: "fa";             checked: root.form.fa;             toggled => { root.form.fa = self.checked; } }
                                    CheckBox { text: "diffusion-fa";   checked: root.form.diffusion_fa;   toggled => { root.form.diffusion_fa = self.checked; } }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    CheckBox { text: "clip-on-cpu";    checked: root.form.clip_on_cpu;    toggled => { root.form.clip_on_cpu = self.checked; } }
                                    CheckBox { text: "vae-on-cpu";     checked: root.form.vae_on_cpu;     toggled => { root.form.vae_on_cpu = self.checked; } }
                                    CheckBox { text: "vae-tiling";     checked: root.form.vae_tiling;     toggled => { root.form.vae_tiling = self.checked; } }
                                }
                            }

                            SectionCard {
                                heading: "Default generation parameters";
                                LabeledField {
                                    label: "Sampler";
                                    ComboBox {
                                        model: ["euler_a","euler","heun","dpm2","dpm++2s_a","dpm++2m","dpm++2mv2","lcm","ipndm","ipndm_v","ddim_trailing","tcd"];
                                        current-value: root.form.sampler == "" ? "euler" : root.form.sampler;
                                        selected(value) => { root.form.sampler = value; }
                                    }
                                }
                                LabeledField {
                                    label: "Flow shift";
                                    LineEdit {
                                        text: root.form.flow_shift;
                                        placeholder-text: "SD3/Wan/Ideogram4 sigma shift; blank = auto (Ideogram4 ref ≈ 5)";
                                        edited(t) => { root.form.flow_shift = t; }
                                    }
                                }
                                LabeledField {
                                    label: "Steps";
                                    LineEdit {
                                        text: "\{root.form.steps}";
                                        input-type: number;
                                        edited(t) => { root.form.steps = t.to-float(); }
                                    }
                                }
                                LabeledField {
                                    label: "CFG scale";
                                    LineEdit {
                                        text: root.form.cfg_scale;
                                        edited(t) => { root.form.cfg_scale = t; }
                                    }
                                }
                                LabeledField {
                                    label: "Guidance";
                                    LineEdit {
                                        text: root.form.guidance;
                                        placeholder-text: "Flux/Flux2 only (default 3.5); blank = unset";
                                        edited(t) => { root.form.guidance = t; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    LabeledField {
                                        label: "Width";
                                        label_width: 60px;
                                        LineEdit {
                                            text: "\{root.form.width}";
                                            input-type: number;
                                            edited(t) => { root.form.width = t.to-float(); }
                                        }
                                    }
                                    LabeledField {
                                        label: "Height";
                                        label_width: 60px;
                                        LineEdit {
                                            text: "\{root.form.height}";
                                            input-type: number;
                                            edited(t) => { root.form.height = t.to-float(); }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Button {
                                    text: "Revert";
                                    enabled: root.selected_preset_index >= 0;
                                    clicked => { root.revert_preset(); }
                                }
                                Button {
                                    text: "Save preset";
                                    primary: true;
                                    enabled: root.selected_preset_index >= 0 && root.form.id != "";
                                    clicked => { root.save_preset(); }
                                }
                            }
                        }
                    }
                }

                // ─────────────── Page 2: MCP clients ───────────────
                if root.current_tab == 2 : ScrollView {
                    // Pin content to the visible width (see the Server tab).
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: stretch;
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: "MCP clients";
                                    font-size: 22px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "Register stable-diffusion.cpp with your AI client so it can call generate_image, list_presets, switch_preset, and friends. Existing entries in each client's config are left untouched.";
                                    color: Palette.foreground.transparentize(0.4);
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Re-detect";
                                    clicked => { root.mcp_refresh(); }
                                }
                            }
                        }

                        for c in root.mcp_clients : Rectangle {
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: 8px;
                            background: Palette.alternate-background;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: stretch;
                                    spacing: 12px;
                                    Text {
                                        text: c.label;
                                        font-weight: 600;
                                        font-size: 14px;
                                        color: Palette.foreground;
                                        horizontal-stretch: 1;
                                    }
                                    // Status chip (mini-pill on the right edge of the card header)
                                    Rectangle {
                                        height: 22px;
                                        width: badge.preferred-width + 18px;
                                        border-radius: 11px;
                                        background: c.installed
                                            ? #2e7d32.transparentize(0.85)
                                            : Palette.background;
                                        border-width: 1px;
                                        border-color: c.installed ? #2e7d32 : Palette.border;
                                        badge := Text {
                                            text: c.installed ? "installed" : "not installed";
                                            color: c.installed ? #2e7d32 : Palette.foreground.transparentize(0.3);
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: c.config_path;
                                    font-size: 11px;
                                    color: Palette.foreground.transparentize(0.5);
                                    wrap: word-wrap;
                                }
                                if c.note != "" : Text {
                                    text: c.note;
                                    font-size: 11px;
                                    color: #c62828;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: c.installed ? "Reinstall" : "Install";
                                        primary: !c.installed;
                                        clicked => { root.mcp_install(c.id); }
                                    }
                                    Button {
                                        text: "Uninstall";
                                        enabled: c.installed;
                                        clicked => { root.mcp_uninstall(c.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                } // /VerticalLayout (content swap)
            }
        }

        // ─── Footer status bar ──────────────────────────────────────
        // Always present: the action-result toast on the left, the live
        // sd-server status pill on the right (moved here from the old top
        // header). Clicking the pill force-refreshes the state-file probe.
        Rectangle {
            min-height: 40px;
            background: Palette.alternate-background;
            // Top hairline divider.
            Rectangle {
                y: 0;
                height: 1px;
                background: Palette.border;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;
                // Action-result toast (left). Wrapped in a stretch-1 layout so
                // it always claims the leftover width even when empty —
                // otherwise the status pill (a Rectangle, max-width infinite)
                // would absorb the slack and stretch across the whole bar.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Text {
                        horizontal-stretch: 1;
                        text: root.status_text;
                        color: root.status_is_error ? #c62828 : Palette.foreground;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                StatusPill {
                    // A Rectangle defaults to a non-zero stretch, so without
                    // this it would split the bar with the toast container and
                    // balloon full-width. Pinned to 0 → it keeps its content
                    // width and all slack flows to the toast on the left.
                    horizontal-stretch: 0;
                    running: root.server_running;
                    text: root.server_status_text;
                    clicked => { root.refresh_status(); }
                }
            }
        }
    }

    // ─── New-preset model picker (embedded modal) ─────────────────────
    // Lives as a SIBLING of the main VerticalLayout (both children of
    // Window), so it floats over the whole window instead of being
    // sized as a row in the vertical stack. Shows the same scanned
    // model list the editor's Model dropdown uses — the user selects
    // a row, then clicks Empty (fresh defaults) or Clone (carry over
    // every parameter from the source preset onto the picked model).
    // Clone is hidden when nothing is selected in the preset list.
    if root.show_new_kind_picker: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000.transparentize(0.45);
        TouchArea {
            clicked => { root.show_new_kind_picker = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 480px;
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            // Consume clicks inside the card so the backdrop TouchArea
            // doesn't fire (it would dismiss the dialog otherwise).
            TouchArea { }
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "New preset";
                    font-size: 16px;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                Text {
                    text: root.new_dialog_source_id == ""
                        ? "Pick a model from your ModelsDir. The new preset will be created with default parameters."
                        : "Pick a model from your ModelsDir. \"Empty\" creates a preset with default parameters; \"Clone\" copies every parameter of [" + root.new_dialog_source_id + "] onto the picked model.";
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.25);
                }
                Rectangle {
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 8px;
                    background: Palette.alternate-background;
                    vertical-stretch: 1;
                    if root.dialog_model_labels.length == 0 : Text {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        text: "No .gguf / .safetensors files found under ModelsDir. Drop files there and reopen this dialog.";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Palette.foreground.transparentize(0.4);
                    }
                    ListView {
                        for label[i] in root.dialog_model_labels : Rectangle {
                            height: 32px;
                            background: i == root.dialog_model_index
                                ? Palette.accent-background.transparentize(0.82)
                                : (touch.has-hover ? Palette.background : transparent);
                            if i == root.dialog_model_index : Rectangle {
                                x: 0; y: 4px; width: 3px; height: parent.height - 8px;
                                border-radius: 1.5px;
                                background: Palette.accent-background;
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: label;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.dialog_model_index = i; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.show_new_kind_picker = false; }
                    }
                    Button {
                        text: root.new_dialog_source_id == "" ? "Create" : "Empty";
                        enabled: root.dialog_model_index >= 0;
                        clicked => {
                            root.show_new_kind_picker = false;
                            root.pick_new_empty();
                        }
                    }
                    if root.new_dialog_source_id != "" : Button {
                        text: "Clone…";
                        enabled: root.dialog_model_index >= 0;
                        clicked => {
                            root.show_new_kind_picker = false;
                            root.pick_new_clone();
                        }
                    }
                }
            }
        }
    }

    // ─── Rename-preset modal ─────────────────────────────────────────
    // Single-field input that rewrites only the `[id]` header line in
    // presets.ini — the keys/comments below stay byte-for-byte intact
    // (see ini::rename_section). Submit on Enter via the LineEdit's
    // `accepted` callback so the dialog feels like a native rename.
    if root.show_rename_dialog: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000.transparentize(0.45);
        TouchArea {
            clicked => { root.show_rename_dialog = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 220px;
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            // Eat clicks so the backdrop dismiss doesn't fire underneath.
            TouchArea { }
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "Rename preset";
                    font-size: 16px;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                Text {
                    text: "Renaming [" + root.rename_old_id + "]. This only changes the section header in presets.ini; every parameter inside is preserved.";
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.25);
                }
                LineEdit {
                    text: root.rename_new_id;
                    placeholder-text: "New id";
                    edited(t) => { root.rename_new_id = t; }
                    accepted(t) => {
                        root.rename_new_id = t;
                        if (t != "" && t != root.rename_old_id) {
                            root.show_rename_dialog = false;
                            root.rename_preset(root.rename_old_id, t);
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.show_rename_dialog = false; }
                    }
                    Button {
                        text: "Rename";
                        primary: true;
                        enabled: root.rename_new_id != "" && root.rename_new_id != root.rename_old_id;
                        clicked => {
                            root.show_rename_dialog = false;
                            root.rename_preset(root.rename_old_id, root.rename_new_id);
                        }
                    }
                }
            }
        }
    }

    // ─── Top-right app-icon menu trigger ──────────────────────────────
    // Replaces the old header: a clickable app icon floating in the
    // top-right corner. Click → toggle the overflow menu below. Hidden
    // while any modal is open so it never floats over a dialog backdrop.
    if !root.show_new_kind_picker && !root.show_rename_dialog && !root.show_about_dialog : Rectangle {
        x: root.width - self.width - 12px;
        y: 8px;
        width: 36px;
        height: 32px;
        border-radius: 6px;
        background: menu_touch.has-hover || root.show_app_menu
            ? Palette.alternate-background
            : transparent;
        Image {
            source: root.window_icon;
            width: 24px;
            height: 24px;
            image-fit: contain;
        }
        menu_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.show_app_menu = !root.show_app_menu; }
        }
    }

    // ─── Overflow menu popup ──────────────────────────────────────────
    // A transparent full-window TouchArea catches outside clicks to
    // dismiss; the menu card is anchored just under the icon.
    if root.show_app_menu : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.show_app_menu = false; }
        }
        Rectangle {
            x: root.width - self.width - 12px;
            y: 44px;
            width: 240px;
            height: 93px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            // Eat clicks inside the menu so the backdrop dismiss doesn't fire.
            TouchArea { }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                // Stop Server — greyed out and inert while nothing is running.
                Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    background: (stop_touch.has-hover && root.server_running)
                        ? Palette.alternate-background
                        : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Stop Server";
                            vertical-alignment: center;
                            font-size: 13px;
                            color: root.server_running
                                ? Palette.foreground
                                : Palette.foreground.transparentize(0.6);
                        }
                    }
                    stop_touch := TouchArea {
                        mouse-cursor: root.server_running ? pointer : default;
                        clicked => {
                            if (root.server_running) {
                                root.show_app_menu = false;
                                root.stop_server();
                            }
                        }
                    }
                }
                // Separator between the action and About.
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Palette.border;
                    }
                }
                Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    background: about_touch.has-hover ? Palette.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "About";
                            vertical-alignment: center;
                            font-size: 13px;
                            color: Palette.foreground;
                        }
                    }
                    about_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_app_menu = false;
                            root.show_about_dialog = true;
                        }
                    }
                }
            }
        }
    }

    // ─── About modal ──────────────────────────────────────────────────
    // Project info + the live sd-server engine version (server_version,
    // filled in by gui::spawn_version_probe; "detecting…" until it lands).
    if root.show_about_dialog: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000.transparentize(0.45);
        TouchArea {
            clicked => { root.show_about_dialog = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 540px;
            height: 350px;
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            // Eat clicks so the backdrop dismiss doesn't fire underneath.
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    VerticalLayout {
                        alignment: start;
                        Image {
                            source: root.window_icon;
                            width: 48px;
                            height: 48px;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "sd-config";
                            font-size: 20px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }
                        Text {
                            text: "stable-diffusion.cpp configurator & MCP bridge";
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Configurator version";
                            width: 150px;
                            font-size: 13px;
                            color: Palette.foreground.transparentize(0.35);
                        }
                        Text {
                            text: root.app_version != "" ? root.app_version : "—";
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Engine version";
                            width: 150px;
                            font-size: 13px;
                            color: Palette.foreground.transparentize(0.35);
                        }
                        Text {
                            text: root.server_version != "" ? root.server_version : "detecting…";
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Upstream";
                            width: 150px;
                            font-size: 13px;
                            color: Palette.foreground.transparentize(0.35);
                        }
                        Text {
                            text: "github.com/leejet/stable-diffusion.cpp";
                            font-size: 13px;
                            color: Palette.foreground;
                        }
                    }
                    Text {
                        text: "Configure sd-server, manage per-model presets, and register the image-generation MCP server with your AI clients. Images are generated through sd-server's built-in web UI or the MCP tools.";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(0.25);
                        wrap: word-wrap;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        primary: true;
                        clicked => { root.show_about_dialog = false; }
                    }
                }
            }
        }
    }
}
